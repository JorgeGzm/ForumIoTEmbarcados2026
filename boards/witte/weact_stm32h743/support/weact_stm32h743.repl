gpioa: GPIOPort.STM32_GPIOPort @ {
        sysbus <0x58020000, +0x400>;
        rcc RegistrationPeripheralAlias.GPIOA
    }

gpiob: GPIOPort.STM32_GPIOPort @ {
        sysbus <0x58020400, +0x400>;
        rcc RegistrationPeripheralAlias.GPIOB
    }

gpioc: GPIOPort.STM32_GPIOPort @ {
        sysbus <0x58020800, +0x400>;
        rcc RegistrationPeripheralAlias.GPIOC
    }

gpiod: GPIOPort.STM32_GPIOPort @ {
        sysbus <0x58020c00, +0x400>;
        rcc RegistrationPeripheralAlias.GPIOD
    }

gpioe: GPIOPort.STM32_GPIOPort @ {
        sysbus <0x58021000, +0x400>;
        rcc RegistrationPeripheralAlias.GPIOE
    }

gpiof: GPIOPort.STM32_GPIOPort @ {
        sysbus <0x58021400, +0x400>;
        rcc RegistrationPeripheralAlias.GPIOF
    }

gpiog: GPIOPort.STM32_GPIOPort @ {
        sysbus <0x58021800, +0x400>;
        rcc RegistrationPeripheralAlias.GPIOG
    }

gpioh: GPIOPort.STM32_GPIOPort @ {
        sysbus <0x58021c00, +0x400>;
        rcc RegistrationPeripheralAlias.GPIOH
    }

gpioi: GPIOPort.STM32_GPIOPort @ {
        sysbus <0x58022000, +0x400>;
        rcc RegistrationPeripheralAlias.GPIOI
    }

gpioj: GPIOPort.STM32_GPIOPort @ {
        sysbus <0x58022400, +0x400>;
        rcc RegistrationPeripheralAlias.GPIOJ
    }

gpiok: GPIOPort.STM32_GPIOPort @ {
        sysbus <0x58022800, +0x400>;
        rcc RegistrationPeripheralAlias.GPIOK
    }

pwrcfg: Python.PythonPeripheral @ sysbus 0x58024800
    size: 0x400
    initable: true
    filename: "scripts/pydev/flipflop.py"

itcm: Memory.MappedMemory @ sysbus 0x0
    size: 0x10000

flashBank1: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000

flashBank2: Memory.MappedMemory @ sysbus 0x08100000
    size: 0x100000

flashController: MTD.STM32H7_FlashController @ sysbus 0x52002000
    flash1: flashBank1
    flash2: flashBank2
    -> nvic0@4

dtcm: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

sram0_axiSram: Memory.MappedMemory @ sysbus 0x24000000
    size: 0x80000

sram1: Memory.MappedMemory @ sysbus 0x30000000
    size: 0x20000

sram2: Memory.MappedMemory @ sysbus 0x30020000
    size: 0x20000

sram3: Memory.MappedMemory @ sysbus 0x30040000
    size: 0x8000

sram4: Memory.MappedMemory @ sysbus 0x38000000
    size: 0x10000

extmemory: Memory.MappedMemory @ sysbus 0x90000000
    size: 0x10000000

// autogenerated

nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
}
    -> cpu0@0

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m7"
    nvic: nvic0

rcc: Miscellaneous.STM32H7_RCC @ sysbus 0x58024400
    systick: nvic0
    hseFrequency: 25000000

userled: Miscellaneous.LED @ gpioe 0x3

gpioe:
    3 -> userled@0

userbutton: Miscellaneous.Button @ gpioc 0xd
    -> gpioc@13

uart4: UART.STM32F7_USART @ {
        sysbus 0x40004c00;
        rcc RegistrationPeripheralAlias.UART4
    }
    frequency: 200000000
    IRQ->nvic0@52

spi1: SPI.STM32H7_SPI @ {
        sysbus 0x40013000;
        rcc RegistrationPeripheralAlias.SPI1
    }

spi4: SPI.STM32H7_SPI @ {
        sysbus 0x40013400;
        rcc RegistrationPeripheralAlias.SPI4
    }

rng: Miscellaneous.STM32_RNG @ {
        sysbus 0x48021800;
        rcc RegistrationPeripheralAlias.RNG
    }
    series: STM32Series.F4
    ->nvic0@80

rtc: Timers.STM32F4_RTC @ {
        sysbus 0x58004000;
        rcc RegistrationPeripheralAlias.RTC
    }
    AlarmIRQ->nvic0@41

iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x58004800
    frequency: 32000

// cortex-m overlay

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000

// st,stm32h7 overlay

cpu0:
    numberOfMPURegions: 16

sysbus:
    init add:
        Tag <0x58024800 4> "PWR_CR1_DBP_SET" 0x100
        Tag <0x58024808 4> "PWR_CR2_BREN_SET" 0x1
        Tag <0x58024818 4> "D3CR.VOSRDY" 0x2000
        Tag <0x58026410 4> "HSEM_UNLOCK" 0x80000000 overridePeripheralAccesses=True

// st,stm32h743 overlay
