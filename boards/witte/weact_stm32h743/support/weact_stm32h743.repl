// Generated by dts2repl (github.com/antmicro/dts2repl) from the zephyr.dts
// of a weact_stm32h743 test build:
//   dts2repl build/zephyr/zephyr.dts -o weact_stm32h743.repl
// Models what Renode supports (CPU, RCC, GPIO, UART4, SPI, IWDG, memories);
// the QSPI/SPI NORs and the display are not emulated.
// Manual fix: dts2repl maps the H7 SPIs to SPI.STM32SPI (the F4 IP, other
// register map); spi1/spi4 use SPI.STM32H7_SPI as in Renode's stm32h7.repl.
// Manual fix: dts2repl omits the flash controller; flash is split in the two
// 1 MB banks MTD.STM32H7_FlashController expects (as in stm32h7.repl).

sysbus:
    init:
        Tag <0x90000000 0x10000000> "quadspi"
        Tag <0x0 0x800000> "boot_partition / storage_partition / slot1_partition / ts_cal1_otp / ts_cal2_otp / vrefint_otp / slot0_partition / scratch_partition"
        Tag <0x40080000 0x40000> "usbotg_fs"
        Tag <0x40028000 0x8000> "ethernet@40028000"
        Tag <0x58020000 0x2400> "pinctrl"
