:name: WeAct MiniSTM32H743
:description: Zephyr on the WeAct MiniSTM32H743 (platform generated by dts2repl)

$name?="weact_stm32h743"

using sysbus
mach create $name
machine LoadPlatformDescription $ORIGIN/weact_stm32h743.repl

showAnalyzer uart4

macro reset
"""
    sysbus LoadELF $elf
    cpu0 VectorTableOffset `sysbus GetSymbolAddress "_vector_table"`
"""
runMacro $reset
