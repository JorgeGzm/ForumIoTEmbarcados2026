/* Demo UI on the host: SDL display window with the panel geometry, and
 * the user store (LittleFS) on the flash simulator. The stock storage
 * partition is only 16 KB: grow the simulated flash to 4 MB and give the
 * users a 1 MB partition after the default layout. */

/ {
	chosen {
		zephyr,display = &sdl_dc;
		app,users-partition = &users_partition;
	};
};

&sdl_dc {
	width = <160>;
	height = <80>;
};

&flashcontroller0 {
	reg = <0x00000000 DT_SIZE_M(4)>;
};

&flash0 {
	reg = <0x00000000 DT_SIZE_M(4)>;

	partitions {
		users_partition: partition@200000 {
			label = "users";
			reg = <0x00200000 DT_SIZE_M(1)>;
		};
	};
};
